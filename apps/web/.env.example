# Copy to apps/web/.env (git-ignored) and fill in. Never commit real values.
# Hosted project: Supabase dashboard → Project Settings → API (Project URL, and the anon or publishable key).
# Local stack: `pnpm db:start` prints both.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Newer projects show a "publishable" key (sb_publishable_…) instead of the anon key. Either works; if both are set,
# the publishable key wins.
VITE_SUPABASE_PUBLISHABLE_KEY=
