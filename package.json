{
  "name": "dnd-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:mutations": "node scripts/mutation-check.mjs",
    "db:push": "supabase db push",
    "db:types": "node scripts/gen-types.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed:dev": "node scripts/seed-dev.mjs",
    "engine:sync": "node scripts/sync-engine.mjs",
    "engine:check": "node scripts/sync-engine.mjs --check",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/roll supabase/functions/create-character supabase/functions/apply-level-up && deno lint --config supabase/functions/deno.json supabase/functions/roll supabase/functions/create-character supabase/functions/apply-level-up",
    "functions:serve": "supabase functions serve",
    "test:functions": "deno test --no-prompt --config supabase/functions/deno.json supabase/functions",
    "srd:import": "node packages/srd-data/scripts/import.ts",
    "test:e2e": "pnpm -C e2e test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
